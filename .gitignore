# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local-agent.example
.dev.vars*
!.dev.vars.example

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/
/tmp/
/.pnpm-store/
/tsconfig.tsbuildinfo
/local-runtime/data/
/local-runtime/vendor/dsh-plugins/
/harness-service/data/
/harness-service/harness-service/data/
/openclaw/openclaw.json
/openclaw/state/

# Python runtime artifacts
__pycache__/
*.py[cod]
.venv/
