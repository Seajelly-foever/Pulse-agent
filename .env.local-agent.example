# 复制为 .env.local-agent。不要把真实密钥提交到 Git 或发送到聊天中。
LOCAL_GATEWAY_SECRET=change-this-to-a-long-random-string
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 通信驱动：默认且唯一启用飞书 CLI；native-feishu / openclaw 仅保留为回滚适配器。
PULSE_CHANNEL_DRIVER=lark-cli
LARK_CLI_BIN=lark-cli
LARK_DOC_IDENTITY=user
LARK_GROUP_HISTORY_IDENTITY=auto
PULSE_GROUP_CHAT_ENABLED=true
PULSE_GROUP_ALLOW_MEMBERS=true
PULSE_GROUP_AUTO_CAPTURE=true
PULSE_GROUP_HISTORY_PAGE_LIMIT=10
PULSE_GROUP_ACK_ENABLED=true
PULSE_GROUP_ACK_TEXT=正在努力思考中，请稍等
PULSE_GROUP_ACK_EMOJI=OneSecond
PULSE_GROUP_SYNC_ENABLED=true
PULSE_GROUP_SYNC_INTERVAL_MINUTES=30
PULSE_GROUP_SYNC_MIN_MESSAGES=1
PULSE_SCHEDULED_TASKS_ENABLED=true
PULSE_BOT_MENTION_NAMES="Alex,Pulse,Feishu Book"
OPENCLAW_BRIDGE_SECRET=change-this-to-a-third-long-random-string
OPENCLAW_GATEWAY_TOKEN=change-this-to-an-openclaw-token

# 飞书开放平台 -> 自建应用 -> 凭证与基础信息
FEISHU_ENABLED=true
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=

# 可选：首次启动前已知自己的 open_id 时可直接放行；否则使用六位配对码。
FEISHU_OWNER_OPEN_IDS=

# DeepSeek Harness
DEEPSEEK_API_KEY=replace-with-a-new-rotated-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DSH_MODEL=deepseek-v4-flash
HARNESS_SHARED_SECRET=change-this-to-another-long-random-string
HARNESS_TIMEOUT_MS=120000
PULSE_MAX_TOOL_STEPS=6

# 公开网页搜索：默认不暴露给模型。公司网络可只访问 Bing 时使用 bing；自托管实例使用 searxng。
PULSE_WEB_SEARCH_PROVIDER=
SEARXNG_BASE_URL=http://127.0.0.1:8888
PULSE_BING_SEARCH_URL=http://127.0.0.1:8090/v1/tools/web-search
PULSE_BING_REGION=cn-zh
# 网页正文读取与搜索分开开关；只允许公网 HTTP(S)，禁止本机和内网地址。
PULSE_WEB_FETCH_ENABLED=false
PULSE_WEB_TOOL_TIMEOUT_MS=15000

# 这两项会把任务输入/输出或历史 Run 证据再次发送给当前模型，只在你明确授权后改为 true。
POST_TASK_DREAMING_ENABLED=false
POST_TASK_DREAMING_MIN_CHARS=8
SKILL_EVOLUTION_ENABLED=false
SKILL_EVOLUTION_DAY=0
SKILL_EVOLUTION_HOUR=21
SKILL_EVOLUTION_MIN_RUNS=5

# Hermes-inspired Memory Curator：每周日 20:00（Asia/Shanghai）生成记忆候选。
WEEKLY_MEMORY_ENABLED=true
WEEKLY_MEMORY_DAY=0
WEEKLY_MEMORY_HOUR=20
PULSE_TIMEZONE=Asia/Shanghai
