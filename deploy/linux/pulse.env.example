# Pulse Linux production environment. Copy to /etc/pulse/pulse.env and chmod 600.
# Never commit the real file or paste secrets into chat.

NODE_ENV=production
PORT=3000
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8789
HARNESS_PORT=8090
LOCAL_GATEWAY_URL=http://127.0.0.1:8789
HARNESS_API_URL=http://127.0.0.1:8090
PULSE_DATA_ROOT=/srv/pulse
PULSE_DATABASE_PATH=/srv/pulse/pulse.db
DSH_SESSION_ROOT=/srv/pulse/harness-sessions

LOCAL_GATEWAY_SECRET=replace-with-a-long-random-secret
HARNESS_SHARED_SECRET=replace-with-another-long-random-secret

PULSE_CHANNEL_DRIVER=lark-cli
LARK_CLI_BIN=/home/REPLACE_USER/.local/bin/lark-cli
LARK_DOC_IDENTITY=user
LARK_GROUP_HISTORY_IDENTITY=auto
PULSE_GROUP_CHAT_ENABLED=true
PULSE_GROUP_ALLOW_MEMBERS=true
PULSE_GROUP_AUTO_CAPTURE=true
PULSE_GROUP_HISTORY_PAGE_LIMIT=10
PULSE_GROUP_ACK_ENABLED=true
PULSE_GROUP_ACK_TEXT=正在努力思考中，请稍等
PULSE_GROUP_ACK_EMOJI=OneSecond
PULSE_GROUP_SYNC_ENABLED=true
PULSE_GROUP_SYNC_INTERVAL_MINUTES=30
PULSE_GROUP_SYNC_MIN_MESSAGES=1
PULSE_SCHEDULED_TASKS_ENABLED=true
PULSE_BOT_MENTION_NAMES="Alex,Pulse,Feishu Book"

# The app credentials are also configured in lark-cli. Keep them only in this protected file or a secret manager.
FEISHU_ENABLED=true
FEISHU_APP_ID=replace-in-server-only
FEISHU_APP_SECRET=replace-in-server-only
FEISHU_OWNER_OPEN_IDS=

DEEPSEEK_API_KEY=replace-in-server-only
DEEPSEEK_BASE_URL=https://api.deepseek.com
DSH_MODEL=deepseek-v4-flash
HARNESS_MODEL=deepseek-v4-flash
HARNESS_TIMEOUT_MS=120000
PULSE_MAX_TOOL_STEPS=6

# Optional public web tools. Use the strict Bing provider, or point searxng at a trusted instance.
PULSE_WEB_SEARCH_PROVIDER=
SEARXNG_BASE_URL=http://127.0.0.1:8888
PULSE_BING_SEARCH_URL=http://127.0.0.1:8090/v1/tools/web-search
PULSE_BING_REGION=cn-zh
# Direct page fetch is separately gated because the model chooses the URL.
PULSE_WEB_FETCH_ENABLED=false
PULSE_WEB_TOOL_TIMEOUT_MS=15000

POST_TASK_DREAMING_ENABLED=false
SKILL_EVOLUTION_ENABLED=false
WEEKLY_MEMORY_ENABLED=true
WEEKLY_MEMORY_DAY=0
WEEKLY_MEMORY_HOUR=20
PULSE_TIMEZONE=Asia/Shanghai
